---
interface Props {
  title: string;
  description: string;
  schema?: object;
}

const { title, description, schema } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans antialiased min-h-screen flex flex-col">
    <!-- Top Trust Bar -->
    <div class="bg-slate-900 text-slate-200 text-xs py-2 px-4 border-b border-slate-800">
      <div class="max-w-6xl mx-auto flex flex-wrap justify-between items-center gap-2">
        <div class="flex items-center space-x-4">
          <span class="flex items-center text-emerald-400 font-medium">
            <svg class="w-4 h-4 mr-1 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            Rated 4.96/5 by 350+ UK Homeowners
          </span>
          <span class="hidden sm:inline text-slate-400">|</span>
          <span class="hidden sm:inline">🛡️ £2,000,000 Public Liability Insured</span>
        </div>
        <div class="flex items-center space-x-3 text-slate-300">
          <span>✓ 12-Month Workmanship Guarantee</span>
          <span>✓ 100% Fixed Price Quotes</span>
        </div>
      </div>
    </div>

    <!-- Navigation Header -->
    <header class="bg-white shadow-sm sticky top-0 z-40">
      <div class="max-w-6xl mx-auto px-4 py-3.5 flex justify-between items-center">
        <a href="/" class="flex items-center space-x-2">
          <div class="bg-sky-700 text-white p-2 rounded-lg font-bold text-xl leading-none">PT</div>
          <div>
            <span class="font-extrabold text-xl text-slate-900 tracking-tight">PrimeTilers<span class="text-sky-700">.uk</span></span>
            <span class="block text-[10px] uppercase tracking-wider font-semibold text-slate-500">Verified Master Tilers UK</span>
          </div>
        </a>

        <div class="flex items-center space-x-6">
          <nav class="hidden md:flex space-x-6 text-sm font-medium text-slate-600">
            <a href="/#services" class="hover:text-sky-700 transition">Services</a>
            <a href="/pricing" class="hover:text-sky-700 transition">Price Guide</a>
            <a href="/#areas" class="hover:text-sky-700 transition">Areas Covered</a>
            <a href="/#reviews" class="hover:text-sky-700 transition">Reviews</a>
          </nav>
          <a href="/quote" class="bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold px-4 py-2 rounded-md shadow-sm transition text-sm flex items-center">
            Get Free Quote
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 text-slate-400 py-12 border-t border-slate-800">
      <div class="max-w-6xl mx-auto px-4 grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
        <div>
          <span class="font-extrabold text-xl text-white tracking-tight">PrimeTilers<span class="text-sky-500">.uk</span></span>
          <p class="text-xs text-slate-400 mt-2">Connecting UK homeowners with verified, high-precision wall & floor tiling specialists. Fixed prices, laser alignment, zero rogue traders.</p>
          <div class="mt-4 flex items-center space-x-2 text-xs text-slate-300">
            <span class="bg-emerald-950 text-emerald-400 border border-emerald-800 px-2 py-1 rounded">✓ Verified Vetted Trades</span>
          </div>
        </div>
        <div>
          <h4 class="text-sm font-semibold text-white uppercase tracking-wider mb-3">Popular Services</h4>
          <ul class="space-y-2 text-xs">
            <li><a href="/bathroom-tiling/reading" class="hover:text-white transition">Bathroom Tiling & Renovation</a></li>
            <li><a href="/kitchen-tiling/reading" class="hover:text-white transition">Kitchen Splashbacks & Floors</a></li>
            <li><a href="/floor-tiling/reading" class="hover:text-white transition">Floor Tiling & Underfloor Heating</a></li>
            <li><a href="/wet-room-installation/reading" class="hover:text-white transition">Wet Room Tanking & Waterproofing</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-sm font-semibold text-white uppercase tracking-wider mb-3">Top Coverage Areas</h4>
          <ul class="space-y-2 text-xs">
            <li><a href="/bathroom-tiling/reading" class="hover:text-white transition">Tilers in Reading (RG)</a></li>
            <li><a href="/bathroom-tiling/oxford" class="hover:text-white transition">Tilers in Oxford (OX)</a></li>
            <li><a href="/bathroom-tiling/guildford" class="hover:text-white transition">Tilers in Guildford (GU)</a></li>
            <li><a href="/bathroom-tiling/birmingham" class="hover:text-white transition">Tilers in Birmingham (B)</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-sm font-semibold text-white uppercase tracking-wider mb-3">Trust & Security</h4>
          <p class="text-xs text-slate-400">All member tilers are verified with £2M+ Public Liability Insurance and backed by our 12-Month Workmanship Guarantee.</p>
          <div class="mt-4 text-xs text-slate-500">
            © 2026 PrimeTilers.uk. All rights reserved.
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
