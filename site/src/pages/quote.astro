---
import Layout from '../layouts/Layout.astro';
import TrustBadges from '../components/TrustBadges.astro';
---

<Layout title="Get a Free Fixed Tiling Quote | PrimeTilers.uk" description="Get a free, transparent fixed-price quote from a verified local master tiler. No hidden costs. 12-month guarantee.">
  <div class="max-w-3xl mx-auto px-4 py-12">
    <div class="text-center mb-8">
      <span class="bg-emerald-100 text-emerald-800 text-xs font-bold px-3 py-1 rounded-full uppercase">100% Free & No Obligation</span>
      <h1 class="text-3xl font-extrabold text-slate-900 mt-3">Request Your Fixed Price Quote</h1>
      <p class="text-xs text-slate-500 mt-1">Answer 4 quick questions to receive a transparent price and booking availability within 1 hour.</p>
    </div>

    <div class="bg-white rounded-2xl shadow-xl border border-slate-200 p-6 md:p-10">
      <form id="lead-form" class="space-y-6">
        <!-- Step 1: Location -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">1. Your Property Postcode</label>
          <input type="text" id="lead-postcode" name="postcode" required placeholder="e.g. RG1 2AB or SW1A 1AA" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-3 text-sm font-semibold uppercase focus:ring-2 focus:ring-sky-500" />
        </div>

        <!-- Step 2: Service Type -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">2. What type of tiling do you need?</label>
          <div class="grid grid-cols-2 gap-3">
            <label class="border border-slate-300 rounded-lg p-3 flex items-center space-x-2 text-xs font-medium cursor-pointer hover:bg-sky-50 has-[:checked]:border-sky-600 has-[:checked]:bg-sky-50">
              <input type="radio" name="service_type" value="Full Bathroom Renovation" checked class="text-sky-600" />
              <span>Full Bathroom Tiling</span>
            </label>
            <label class="border border-slate-300 rounded-lg p-3 flex items-center space-x-2 text-xs font-medium cursor-pointer hover:bg-sky-50 has-[:checked]:border-sky-600 has-[:checked]:bg-sky-50">
              <input type="radio" name="service_type" value="Kitchen Splashback" class="text-sky-600" />
              <span>Kitchen Splashback</span>
            </label>
            <label class="border border-slate-300 rounded-lg p-3 flex items-center space-x-2 text-xs font-medium cursor-pointer hover:bg-sky-50 has-[:checked]:border-sky-600 has-[:checked]:bg-sky-50">
              <input type="radio" name="service_type" value="Living / Hall Floor Tiling" class="text-sky-600" />
              <span>Floor Tiling</span>
            </label>
            <label class="border border-slate-300 rounded-lg p-3 flex items-center space-x-2 text-xs font-medium cursor-pointer hover:bg-sky-50 has-[:checked]:border-sky-600 has-[:checked]:bg-sky-50">
              <input type="radio" name="service_type" value="Walk-in Wet Room" class="text-sky-600" />
              <span>Wet Room Tanking</span>
            </label>
          </div>
        </div>

        <!-- Step 3: Details -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">3. Describe your job (Optional)</label>
          <textarea id="lead-notes" name="notes" rows="2" placeholder="e.g. Replacing old cracked ceramic tiles with 600x600 porcelain. Need it done within 2 weeks." class="w-full bg-slate-50 border border-slate-300 rounded-lg p-3 text-sm focus:ring-2 focus:ring-sky-500"></textarea>
        </div>

        <!-- Step 4: Contact -->
        <div class="border-t border-slate-200 pt-6">
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">4. Your Contact Details</label>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <span class="block text-xs text-slate-500 mb-1">Your Full Name</span>
              <input type="text" id="lead-name" name="name" required placeholder="e.g. David Smith" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-3 text-sm" />
            </div>
            <div>
              <span class="block text-xs text-slate-500 mb-1">UK Phone / WhatsApp Number</span>
              <input type="tel" id="lead-phone" name="phone" required placeholder="e.g. 07123 456789" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-3 text-sm" />
            </div>
          </div>
        </div>

        <button type="submit" id="submit-btn" class="w-full bg-amber-500 hover:bg-amber-600 text-slate-950 font-extrabold text-base py-4 rounded-xl shadow-lg transition flex items-center justify-center">
          <span>Get Free Fixed Quote & Availability →</span>
        </button>
      </form>

      <div id="success-message" class="hidden text-center py-8 space-y-4">
        <div class="w-16 h-16 bg-emerald-100 text-emerald-700 rounded-full flex items-center justify-center mx-auto text-2xl font-bold">✓</div>
        <h3 class="text-2xl font-extrabold text-slate-900">Thank You! Quote Request Received</h3>
        <p class="text-xs text-slate-600 max-w-md mx-auto">Your enquiry has been dispatched to our verified master tiler in your area. You will receive an SMS and WhatsApp quotation with fixed price options shortly.</p>
      </div>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('lead-form');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('submit-btn');
    if (btn) btn.innerHTML = 'Sending enquiry...';

    const payload = {
      name: (document.getElementById('lead-name') as HTMLInputElement).value,
      phone: (document.getElementById('lead-phone') as HTMLInputElement).value,
      postcode: (document.getElementById('lead-postcode') as HTMLInputElement).value,
      service: (form.querySelector('input[name="service_type"]:checked') as HTMLInputElement)?.value,
      notes: (document.getElementById('lead-notes') as HTMLTextAreaElement).value,
      timestamp: new Date().toISOString()
    };

    try {
      // Send to local AI Dispatch Webhook Server
      await fetch('http://127.0.0.1:8000/api/lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
    } catch (err) {
      console.log('Dispatched offline simulation');
    }

    form.classList.add('hidden');
    document.getElementById('success-message')?.classList.remove('hidden');
  });
</script>
