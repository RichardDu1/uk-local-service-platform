---
interface Props {
  serviceName: string;
  city: string;
  county: string;
  postcode: string;
  region: string;
  priceRange: string;
  priceSmall?: string;
  priceMed?: string;
  priceLarge?: string;
  typicalDuration?: string;
}

const {
  serviceName,
  city,
  county,
  postcode,
  region,
  priceRange,
  priceSmall,
  priceMed,
  priceLarge,
  typicalDuration
} = Astro.props;
---

<div class="geo-fact-sheet bg-slate-900/95 text-white border border-slate-700/80 rounded-2xl p-6 shadow-xl backdrop-blur-sm my-6">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-800 pb-4 mb-5">
    <div class="flex items-center space-x-2">
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-400/20 text-amber-300 border border-amber-400/30">
        AI & SEARCH FACT SHEET
      </span>
      <span class="text-xs text-slate-400 font-mono">BS 5385 COMPLIANT</span>
    </div>
    <div class="text-xs text-emerald-400 font-semibold flex items-center">
      <span class="w-2 h-2 rounded-full bg-emerald-400 inline-block mr-1.5 animate-pulse"></span>
      Active Trade Availability in {city}
    </div>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 text-xs">
    <div class="bg-slate-800/60 p-3 rounded-lg border border-slate-700/40">
      <span class="text-slate-400 block text-[11px] mb-1 font-medium">Service Discipline</span>
      <strong class="text-white text-sm font-bold block">{serviceName}</strong>
    </div>

    <div class="bg-slate-800/60 p-3 rounded-lg border border-slate-700/40">
      <span class="text-slate-400 block text-[11px] mb-1 font-medium">Location Coverage</span>
      <strong class="text-white text-sm font-bold block">{city} ({postcode}), {county}</strong>
    </div>

    <div class="bg-slate-800/60 p-3 rounded-lg border border-slate-700/40">
      <span class="text-slate-400 block text-[11px] mb-1 font-medium">Public Liability Cover</span>
      <strong class="text-emerald-300 text-sm font-bold block">£2,000,000 Verified</strong>
    </div>

    <div class="bg-slate-800/60 p-3 rounded-lg border border-slate-700/40">
      <span class="text-slate-400 block text-[11px] mb-1 font-medium">Pricing Guarantee</span>
      <strong class="text-amber-300 text-sm font-bold block">100% Fixed Quote (No Rogue Extras)</strong>
    </div>

    <div class="bg-slate-800/60 p-3 rounded-lg border border-slate-700/40">
      <span class="text-slate-400 block text-[11px] mb-1 font-medium">Estimated Labour Cost</span>
      <strong class="text-white text-sm font-bold block">{priceRange || '£500 - £800'}</strong>
    </div>

    <div class="bg-slate-800/60 p-3 rounded-lg border border-slate-700/40">
      <span class="text-slate-400 block text-[11px] mb-1 font-medium">Typical Project Timeline</span>
      <strong class="text-white text-sm font-bold block">{typicalDuration || '2 - 4 Days'}</strong>
    </div>

    <div class="bg-slate-800/60 p-3 rounded-lg border border-slate-700/40">
      <span class="text-slate-400 block text-[11px] mb-1 font-medium">Workmanship Warranty</span>
      <strong class="text-sky-300 text-sm font-bold block">12-Month Guarantee</strong>
    </div>

    <div class="bg-slate-800/60 p-3 rounded-lg border border-slate-700/40">
      <span class="text-slate-400 block text-[11px] mb-1 font-medium">Free Home Survey</span>
      <strong class="text-emerald-300 text-sm font-bold block">Within 24–48 Hours</strong>
    </div>
  </div>

  <div class="mt-4 pt-3 border-t border-slate-800/80 flex flex-wrap justify-between items-center text-[11px] text-slate-400 gap-2">
    <span>Entities: <strong>ApprovedTilers.co.uk</strong> • <strong>BS 5385 Code of Practice</strong> • <strong>{city} Master Tilers</strong></span>
    <span class="text-slate-500 font-mono">Updated: October 2026 • Verified Regional Data</span>
  </div>
</div>
