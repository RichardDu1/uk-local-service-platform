---
import Layout from '../layouts/Layout.astro';
import TrustBadges from '../components/TrustBadges.astro';
import PriceCalculator from '../components/PriceCalculator.astro';

const pricingSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://approvedtilers.co.uk/pricing#webpage",
      "url": "https://approvedtilers.co.uk/pricing",
      "name": "UK Tiling Price Guide 2026 | Transparent Labour & Material Costs",
      "description": "Comprehensive guide to wall and floor tiling costs across the UK in 2026.",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://approvedtilers.co.uk" },
          { "@type": "ListItem", "position": 2, "name": "Price Guide", "item": "https://approvedtilers.co.uk/pricing" }
        ]
      }
    },
    {
      "@type": "OfferCatalog",
      "@id": "https://approvedtilers.co.uk/pricing#catalog",
      "name": "UK Standard Tiling Rates & Benchmarks (2026)",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": { "@type": "Service", "name": "Kitchen Splashback Tiling" },
          "priceSpecification": { "@type": "PriceSpecification", "priceCurrency": "GBP", "minPrice": "250", "maxPrice": "420" }
        },
        {
          "@type": "Offer",
          "itemOffered": { "@type": "Service", "name": "Standard Bathroom Wall & Floor Tiling" },
          "priceSpecification": { "@type": "PriceSpecification", "priceCurrency": "GBP", "minPrice": "600", "maxPrice": "950" }
        },
        {
          "@type": "Offer",
          "itemOffered": { "@type": "Service", "name": "Large Floor Tiling" },
          "priceSpecification": { "@type": "PriceSpecification", "priceCurrency": "GBP", "minPrice": "800", "maxPrice": "1400" }
        },
        {
          "@type": "Offer",
          "itemOffered": { "@type": "Service", "name": "Wet Room Tanking & Waterproofing" },
          "priceSpecification": { "@type": "PriceSpecification", "priceCurrency": "GBP", "minPrice": "1200", "maxPrice": "1850" }
        }
      ]
    }
  ]
};
---

<Layout title="UK Tiling Price Guide 2026 | Transparent Labour & Material Costs" description="Comprehensive guide to wall and floor tiling costs across the UK in 2026. Daily labour rates, square metre prices, and full bathroom tiling breakdown." schema={pricingSchema}>
  <div class="max-w-5xl mx-auto px-4 py-12 space-y-12">
    <div class="text-center max-w-2xl mx-auto">
      <span class="bg-sky-100 text-sky-800 text-xs font-bold px-3 py-1 rounded-full uppercase">Transparent Pricing</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-3">UK Tiling & Renovation Cost Guide 2026</h1>
      <p class="text-xs text-slate-600 mt-2">No rogue trader surcharges. Here is the realistic benchmark of what professional master tilers charge across England.</p>
    </div>

    <!-- Pricing Table -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
      <div class="px-6 py-4 bg-slate-900 text-white flex justify-between items-center">
        <h3 class="font-bold text-sm">Typical Average Tiling Project Costs in the UK</h3>
        <span class="text-xs text-slate-400">Updated August 2026</span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-xs text-left">
          <thead class="bg-slate-50 text-slate-700 font-bold border-b border-slate-200">
            <tr>
              <th class="p-4">Project Type</th>
              <th class="p-4">Average Scope</th>
              <th class="p-4">Typical Duration</th>
              <th class="p-4">Estimated Labour Range</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-700">
            <tr>
              <td class="p-4 font-semibold text-slate-900">Kitchen Splashback (Metro/Herringbone)</td>
              <td class="p-4">3 - 6 sqm around worktops</td>
              <td class="p-4">1 Day</td>
              <td class="p-4 font-bold text-sky-800">£250 - £420</td>
            </tr>
            <tr>
              <td class="p-4 font-semibold text-slate-900">Standard Bathroom Wall & Floor Tiling</td>
              <td class="p-4">15 - 20 sqm full tiling</td>
              <td class="p-4">2 - 4 Days</td>
              <td class="p-4 font-bold text-sky-800">£600 - £950</td>
            </tr>
            <tr>
              <td class="p-4 font-semibold text-slate-900">Large Kitchen / Hallway Floor Tiling</td>
              <td class="p-4">20 - 35 sqm Porcelain / Stone</td>
              <td class="p-4">3 - 5 Days</td>
              <td class="p-4 font-bold text-sky-800">£800 - £1,400</td>
            </tr>
            <tr>
              <td class="p-4 font-semibold text-slate-900">Full Wet Room Tanking & Waterproofing</td>
              <td class="p-4">Complete enclosure + level tray</td>
              <td class="p-4">4 - 6 Days</td>
              <td class="p-4 font-bold text-sky-800">£1,200 - £1,850</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Calculator -->
    <PriceCalculator city="Reading" postcode="RG1" />
  </div>
</Layout>
