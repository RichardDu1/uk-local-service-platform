---
import Layout from '../../layouts/Layout.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import { services, regions, pagesForService, absUrl, parsePrice, SITE_URL, ORG_ID } from '../../lib/site';

export async function getStaticPaths() {
  return services.map((svc) => ({ params: { service: svc.slug }, props: { svc } }));
}

const { svc } = Astro.props;
const pages = pagesForService(svc.slug);
const pageUrl = absUrl(`/${svc.slug}`);

// Price tiers straight from the dataset: London boroughs vs. the rest of the UK.
const tier = (rows: typeof pages) => {
  const r = rows[0]?.price_table;
  return r ? { small: r.small_room, medium: r.medium_room, large: r.large_room } : undefined;
};
const london = tier(pages.filter((p) => p.region === 'London'));
const elsewhere = tier(pages.filter((p) => p.region !== 'London'));
const lows = pages.map((p) => parsePrice(p.price_table?.small_room).low).filter(Boolean) as number[];
const minLow = Math.min(...lows);

const byRegion = regions
  .map((region) => ({ region, pages: pages.filter((p) => p.region === region).sort((a, b) => a.city.localeCompare(b.city)) }))
  .filter((r) => r.pages.length);

const title = `${svc.name} in the UK – Typical Costs & Local Tilers | Approved Tilers`;
const description = `${svc.name} across ${pages.length} UK towns and London boroughs. Typical small jobs from £${minLow}, usually ${svc.duration.toLowerCase()}. Compare price ranges by area and request a free fixed quote.`;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": `${pageUrl}#service`,
      "name": svc.name,
      "serviceType": svc.name,
      "url": pageUrl,
      "provider": { "@id": ORG_ID },
      "areaServed": { "@type": "Country", "name": "United Kingdom" },
      "description": description,
      "offers": { "@type": "AggregateOffer", "priceCurrency": "GBP", "lowPrice": minLow }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_URL}/` },
        { "@type": "ListItem", "position": 2, "name": "Services", "item": absUrl('/services') },
        { "@type": "ListItem", "position": 3, "name": svc.name, "item": pageUrl }
      ]
    }
  ]
};
---

<Layout title={title} description={description} schema={schema}>
  <nav aria-label="Breadcrumb" class="bg-slate-900 text-slate-400 text-xs px-4 pt-4">
    <ol class="max-w-6xl mx-auto flex flex-wrap gap-1">
      <li><a href="/" class="hover:text-white">Home</a> ›</li>
      <li><a href="/services" class="hover:text-white">Services</a> ›</li>
      <li class="text-slate-200" aria-current="page">{svc.name}</li>
    </ol>
  </nav>
  <section class="bg-slate-900 text-white pt-8 pb-12 px-4">
    <div class="max-w-6xl mx-auto space-y-4">
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">{svc.name} in the UK</h1>
      <p class="text-slate-300 max-w-3xl">{svc.summary} Available in {pages.length} towns, cities and London boroughs. Typical duration: {svc.duration}.</p>
      <a href="/quote" class="inline-flex bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold px-6 py-3 rounded-lg shadow transition">Get a free fixed quote →</a>
    </div>
  </section>

  <TrustBadges />

  <div class="max-w-6xl mx-auto px-4 py-10 space-y-10">
    <section class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
      <h2 class="text-2xl font-bold text-slate-900 p-6 pb-2">Typical {svc.name} costs</h2>
      <p class="text-sm text-slate-600 px-6">Indicative labour ranges used on our local pages. Your final price is fixed after a free survey.</p>
      <div class="overflow-x-auto p-6">
        <table class="w-full text-sm text-left">
          <thead class="text-xs uppercase text-slate-500 border-b">
            <tr><th class="py-2 pr-4">Area</th><th class="py-2 pr-4">Small room</th><th class="py-2 pr-4">Medium room</th><th class="py-2">Large / complex</th></tr>
          </thead>
          <tbody>
            {elsewhere && <tr class="border-b"><td class="py-2 pr-4 font-medium">Outside London</td><td class="py-2 pr-4">{elsewhere.small}</td><td class="py-2 pr-4">{elsewhere.medium}</td><td class="py-2">{elsewhere.large}</td></tr>}
            {london && <tr><td class="py-2 pr-4 font-medium">London boroughs</td><td class="py-2 pr-4">{london.small}</td><td class="py-2 pr-4">{london.medium}</td><td class="py-2">{london.large}</td></tr>}
          </tbody>
        </table>
      </div>
    </section>

    <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-white rounded-xl border border-slate-200 p-6">
        <h2 class="text-xl font-bold text-slate-900 mb-4">How the job is done</h2>
        <ol class="space-y-3 text-sm text-slate-700">
          {svc.process.map((step) => (
            <li><strong>{step.step}. {step.title}</strong> – {step.desc}</li>
          ))}
        </ol>
      </div>
      <div class="bg-white rounded-xl border border-slate-200 p-6">
        <h2 class="text-xl font-bold text-slate-900 mb-4">What's included</h2>
        <ul class="space-y-2 text-sm text-slate-700 list-disc pl-5">
          {svc.checklist.map((item) => <li>{item}</li>)}
        </ul>
        <h3 class="text-sm font-bold text-slate-900 mt-5 mb-2">Popular tile choices</h3>
        <p class="text-sm text-slate-700">{svc.popularTiles.join(' · ')}</p>
      </div>
    </section>

    <section>
      <h2 class="text-2xl font-bold text-slate-900 mb-6">{svc.name} by location</h2>
      <div class="space-y-8">
        {byRegion.map((r) => (
          <div>
            <h3 class="text-lg font-bold text-slate-800 mb-3 border-b pb-1">{r.region}</h3>
            <ul class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-2 text-sm">
              {r.pages.map((p) => (
                <li><a href={`/${svc.slug}/${p.city_slug}`} class="text-slate-700 hover:text-sky-700">{p.city} <span class="text-slate-400 text-xs">({p.postcode})</span></a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
