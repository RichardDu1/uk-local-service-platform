---
import Layout from '../../layouts/Layout.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import PriceCalculator from '../../components/PriceCalculator.astro';
import dataset from '../../data/tiling_pseo_dataset.json';

export async function getStaticPaths() {
  return dataset.map((item) => ({
    params: {
      service: item.service_slug,
      city: item.city_slug
    },
    props: { data: item }
  }));
}

const { data } = Astro.props;

// For the select dropdown, get unique services
const allServices = [...new Map(dataset.map(item => [item.service_slug, { name: item.service_name, slug: item.service_slug }])).values()];
---

<Layout title={data.h1 + " | 100% Fixed Price Quotes"} description={data.meta_description} schema={data.schema}>
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-slate-900 via-slate-800 to-slate-900 text-white pt-12 pb-16 px-4 relative">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-7 space-y-5">
        <div class="inline-flex items-center space-x-2 bg-sky-950/80 border border-sky-500/30 text-sky-300 text-xs font-semibold px-3 py-1.5 rounded-full">
          <span>📍 Local Master Tiler Serving {data.city} ({data.postcode}) & {data.county}</span>
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white leading-tight">
          {data.h1}
        </h1>
        <p class="text-slate-300 text-base leading-relaxed">
          {data.summary}
        </p>
        
        <!-- NEW: Local Pain Points Block -->
        <div class="bg-slate-800/50 border-l-4 border-amber-500 p-4 rounded-r-lg mt-4">
          <p class="text-sm text-slate-300 italic leading-relaxed">
            "{data.local_pain_points}"
          </p>
        </div>

        <!-- Bullet Highlights -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-2 text-xs text-slate-200">
          <div class="flex items-center space-x-2">
            <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>Laser alignment & flat subfloor prep</span>
          </div>
          <div class="flex items-center space-x-2">
            <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>£2M Public Liability Insurance</span>
          </div>
          <div class="flex items-center space-x-2">
            <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>12-Month Workmanship Warranty</span>
          </div>
          <div class="flex items-center space-x-2">
            <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>100% Fixed Price - No Rogue Extras</span>
          </div>
        </div>

        <div class="pt-4 flex flex-wrap gap-4 items-center">
          <a href={`/quote?city=${encodeURIComponent(data.city)}&postcode=${encodeURIComponent(data.postcode)}`} class="bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold px-7 py-3.5 rounded-lg shadow-lg text-base transition flex items-center">
            Get Your Free Fixed Quote in {data.city}
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
        </div>
      </div>

      <!-- Quick Fast Quote Card -->
      <div class="lg:col-span-5 bg-white text-slate-900 p-6 rounded-2xl shadow-2xl border border-slate-100">
        <div class="border-b border-slate-100 pb-4 mb-4">
          <span class="text-xs font-bold uppercase tracking-wider text-sky-700">Fast Local Response</span>
          <h3 class="text-xl font-extrabold text-slate-900 mt-1">Book Free Home Survey in {data.city}</h3>
          <p class="text-xs text-slate-500 mt-1">Our certified local master tiler can visit your {data.postcode} property within 24-48 hours.</p>
        </div>

        <form action="/quote" method="GET" class="space-y-4">
          <input type="hidden" name="city" value={data.city} />
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Your Postcode in {data.city}</label>
            <input type="text" name="postcode" value={data.postcode} required class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-sm font-medium focus:ring-2 focus:ring-sky-500 uppercase" placeholder="e.g. RG1 2AB" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Project Type</label>
            <select name="service" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-sm">
              {allServices.map((svc: any) => (
                <option value={svc.slug} selected={data.service_slug === svc.slug}>{svc.name}</option>
              ))}
            </select>
          </div>
          <button type="submit" class="w-full bg-sky-700 hover:bg-sky-800 text-white font-bold py-3 rounded-lg shadow text-sm transition">
            Check Tiler Availability & Pricing &rarr;
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- Trust Badges Bar -->
  <TrustBadges />

  <!-- Main Content Body -->
  <section class="max-w-6xl mx-auto px-4 py-12 space-y-12">
    
    <!-- NEW: Local Pricing Table -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
      <div class="bg-slate-50 border-b border-slate-200 p-6">
        <h2 class="text-2xl font-bold text-slate-900">Average {data.service_name} Costs in {data.city} (2025)</h2>
        <p class="text-sm text-slate-600 mt-2">Prices in the {data.county} area vary depending on materials and subfloor condition. Here is a rough guide:</p>
      </div>
      <div class="p-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="border border-slate-100 rounded-lg p-5 text-center shadow-sm">
            <h4 class="text-sm font-bold text-slate-500 uppercase tracking-wide">Small Room</h4>
            <p class="text-2xl font-extrabold text-sky-700 mt-2">{data.price_table?.small_room || data.estimated_price_range}</p>
          </div>
          <div class="border border-sky-100 bg-sky-50/50 rounded-lg p-5 text-center shadow-sm relative">
            <span class="absolute -top-3 left-1/2 transform -translate-x-1/2 bg-sky-600 text-white text-[10px] font-bold px-2 py-1 rounded-full uppercase">Most Common</span>
            <h4 class="text-sm font-bold text-sky-800 uppercase tracking-wide">Medium Room</h4>
            <p class="text-2xl font-extrabold text-sky-900 mt-2">{data.price_table?.medium_room || "Enquire"}</p>
          </div>
          <div class="border border-slate-100 rounded-lg p-5 text-center shadow-sm">
            <h4 class="text-sm font-bold text-slate-500 uppercase tracking-wide">Large / Complex</h4>
            <p class="text-2xl font-extrabold text-sky-700 mt-2">{data.price_table?.large_room || "Enquire"}</p>
          </div>
        </div>
      </div>
    </div>

    <!-- NEW: 3-Step Process -->
    <div class="py-8">
      <h2 class="text-2xl font-bold text-slate-900 mb-8 text-center">Our 3-Step {data.service_name} Process</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {data.service_process?.map((step: any) => (
          <div class="bg-white p-6 rounded-xl border border-slate-100 shadow-sm relative pt-10">
            <div class="absolute -top-5 left-6 bg-sky-600 text-white w-10 h-10 rounded-full flex items-center justify-center font-bold text-lg shadow-lg border-4 border-white">
              {step.step}
            </div>
            <h4 class="text-lg font-bold text-slate-800 mb-3">{step.title}</h4>
            <p class="text-sm text-slate-600 leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Quality Checklist -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 md:p-8">
      <h2 class="text-2xl font-bold text-slate-900 mb-4">Our Technical Standards in {data.city}</h2>
      <p class="text-sm text-slate-600 mb-6">Every project in {data.city} ({data.county}) is completed to British Standard BS 5385 guidelines with rigorous quality control:</p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {data.checklist.map((item: string) => (
          <div class="flex items-start space-x-3 p-3 rounded-lg bg-slate-50 border border-slate-100">
            <span class="text-emerald-600 font-bold mt-0.5">✓</span>
            <span class="text-xs text-slate-700 font-medium leading-relaxed">{item}</span>
          </div>
        ))}
      </div>
    </div>
    
    <!-- NEW: Local FAQs -->
    {data.faqs && (
      <div class="py-6">
        <h2 class="text-2xl font-bold text-slate-900 mb-6">Frequently Asked Questions ({data.city})</h2>
        <div class="space-y-4">
          {data.faqs.map((faq: any) => (
            <div class="bg-white p-5 rounded-lg border border-slate-200">
              <h4 class="font-bold text-slate-800 mb-2">{faq.q}</h4>
              <p class="text-sm text-slate-600">{faq.a}</p>
            </div>
          ))}
        </div>
      </div>
    )}

    
    <!-- NEW: Cross-Service Internal Mesh (Other services in this city) -->
    <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm mt-8">
      <h3 class="text-lg font-bold text-slate-900 mb-2">Other Tiling Services in {data.city}</h3>
      <p class="text-xs text-slate-600 mb-4">Looking for something else? Our {data.city} tilers also specialise in:</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
        {allServices.filter(svc => svc.slug !== data.service_slug).map((svc: any) => (
          <a href={`/${svc.slug}/${data.city_slug}`} class="flex items-center space-x-2 text-sm text-slate-700 hover:text-sky-700 font-medium group transition">
            <span class="text-sky-400 group-hover:text-sky-600">→</span>
            <span>{svc.name}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Nearby Areas Coverage Block (pSEO Internal Mesh) -->
    <div class="bg-slate-100 rounded-xl p-6 border border-slate-200">
      <h3 class="text-lg font-bold text-slate-900 mb-2">Neighbouring Areas We Cover from {data.city}</h3>
      <p class="text-xs text-slate-600 mb-4">Our mobile team operates across {data.county} and neighbouring districts within 35 miles:</p>
      <div class="flex flex-wrap gap-2">
        {data.nearby_areas.map((area: any) => (
          <a href={`/${data.service_slug}/${area.slug}`} class="text-xs bg-white hover:bg-sky-50 text-slate-700 hover:text-sky-800 border border-slate-300 px-3 py-1.5 rounded-md font-medium transition">
            {area.city} ({area.postcode}) – {area.dist_miles} miles
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
