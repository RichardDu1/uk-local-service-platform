---
import Layout from '../layouts/Layout.astro';
import TrustBadges from '../components/TrustBadges.astro';
---

<Layout title="Get a Free Fixed Tiling Quote | ApprovedTilers.co.uk" description="Get a free, transparent fixed-price quote from an approved local master tiler. £2M insured. 12-month workmanship guarantee.">
  <div class="max-w-3xl mx-auto px-4 py-12">
    <div class="text-center mb-8">
      <span class="bg-emerald-100 text-emerald-800 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">100% Free & Fixed Price Guarantee</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-3">Request Your Approved Tiler Quote</h1>
      <p class="text-xs text-slate-500 mt-1 max-w-lg mx-auto">Get matched with a verified, £2M insured master tiler in your local UK town. Fixed labour quotes with zero rogue trader surprises.</p>
    </div>

    <div class="bg-white rounded-2xl shadow-xl border border-slate-200 p-6 md:p-10">
      <!-- Success Message Container -->
      <div id="success-message" class="hidden text-center py-8 space-y-4">
        <div class="w-16 h-16 bg-emerald-100 text-emerald-700 rounded-full flex items-center justify-center mx-auto text-2xl font-bold">✓</div>
        <h3 class="text-2xl font-extrabold text-slate-900">Thank You! Quote Request Received</h3>
        <p class="text-xs text-slate-600 max-w-md mx-auto">Your enquiry has been dispatched to our approved local master tiler in your area. You will receive an SMS and WhatsApp quotation with verified fixed pricing shortly.</p>
        <div class="pt-4">
          <a href="/" class="text-xs font-bold text-sky-700 hover:text-sky-900 underline">← Return to Homepage</a>
        </div>
      </div>

      <!-- Lead Capture Form (Dual-Engine: Native POST + AJAX Enhanced) -->
      <form id="lead-form" action="https://roamglade-form-hub.dwx168200.workers.dev/api/form?service=tiling&list_id=10&inbox_id=wSE3K4odsBvsv6gYzeLTh9et" method="POST" class="space-y-6">
        <input type="hidden" name="source_title" value="Approved Tilers UK" />

        <!-- 1. Postcode -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">1. Property Postcode *</label>
          <input type="text" id="lead-postcode" name="postcode" required placeholder="e.g. RG1 2AB or SW1A 1AA" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-3 text-sm font-bold uppercase focus:ring-2 focus:ring-sky-500" />
        </div>

        <!-- 2. Service Type -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">2. Service Type *</label>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <label class="border border-slate-200 rounded-lg p-3 flex items-center space-x-2.5 text-xs font-medium cursor-pointer hover:bg-sky-50 has-[:checked]:border-sky-600 has-[:checked]:bg-sky-50 has-[:checked]:font-bold">
              <input type="radio" name="service" id="srv-bathroom" value="Full Bathroom Tiling & Renovation" checked class="text-sky-600 focus:ring-sky-500" />
              <span>Full Bathroom Tiling</span>
            </label>
            <label class="border border-slate-200 rounded-lg p-3 flex items-center space-x-2.5 text-xs font-medium cursor-pointer hover:bg-sky-50 has-[:checked]:border-sky-600 has-[:checked]:bg-sky-50 has-[:checked]:font-bold">
              <input type="radio" name="service" id="srv-kitchen" value="Kitchen Splashbacks & Walls" class="text-sky-600 focus:ring-sky-500" />
              <span>Kitchen Splashback & Walls</span>
            </label>
            <label class="border border-slate-200 rounded-lg p-3 flex items-center space-x-2.5 text-xs font-medium cursor-pointer hover:bg-sky-50 has-[:checked]:border-sky-600 has-[:checked]:bg-sky-50 has-[:checked]:font-bold">
              <input type="radio" name="service" id="srv-floor" value="Living / Hallway Floor Tiling" class="text-sky-600 focus:ring-sky-500" />
              <span>Floor Tiling & Underfloor Heating</span>
            </label>
            <label class="border border-slate-200 rounded-lg p-3 flex items-center space-x-2.5 text-xs font-medium cursor-pointer hover:bg-sky-50 has-[:checked]:border-sky-600 has-[:checked]:bg-sky-50 has-[:checked]:font-bold">
              <input type="radio" name="service" id="srv-wetroom" value="Walk-in Wet Room Waterproofing & Tanking" class="text-sky-600 focus:ring-sky-500" />
              <span>Wet Room Tanking & Shower</span>
            </label>
          </div>
        </div>

        <!-- 3. Area Size & Timeframe -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">3. Approximate Room / Area Size</label>
            <select id="lead-area" name="area_size" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-xs font-medium focus:ring-2 focus:ring-sky-500">
              <option value="Small (Up to 8 sqm)">Small (Up to 8 sqm / Splashback)</option>
              <option value="Medium (8 - 18 sqm)" selected>Medium (8 - 18 sqm / Standard Bathroom)</option>
              <option value="Large (18 - 30 sqm)">Large (18 - 30 sqm / Large Floor / En-suite)</option>
              <option value="Extra Large (30+ sqm)">Extra Large (30+ sqm / Commercial / Whole House)</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">4. Desired Start Timeframe</label>
            <select id="lead-timeframe" name="timeframe" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-xs font-medium focus:ring-2 focus:ring-sky-500">
              <option value="Urgent (Within 48 Hours)">Urgent (Within 48 Hours)</option>
              <option value="Within 1 - 2 Weeks" selected>Within 1 - 2 Weeks</option>
              <option value="Next Month (2 - 4 Weeks)">Next Month (2 - 4 Weeks)</option>
              <option value="Flexible / Just Planning">Flexible / Just Getting Quotes</option>
            </select>
          </div>
        </div>

        <!-- 5. Job Notes -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">5. Job Details / Specific Tile Type (Optional)</label>
          <textarea id="lead-notes" name="notes" rows="2" placeholder="e.g. Replacing old cracked ceramic tiles with 600x600 porcelain. Walls need minor skim or subfloor levelling." class="w-full bg-slate-50 border border-slate-300 rounded-lg p-3 text-xs focus:ring-2 focus:ring-sky-500"></textarea>
        </div>

        <!-- 6. Contact Details -->
        <div class="border-t border-slate-200 pt-6">
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-3">6. Where should we send your fixed quote? *</label>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div>
              <span class="block text-[11px] font-semibold text-slate-600 mb-1">Your Full Name *</span>
              <input type="text" id="lead-name" name="name" required placeholder="e.g. David Miller" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-xs font-medium" />
            </div>
            <div>
              <span class="block text-[11px] font-semibold text-slate-600 mb-1">UK Phone / WhatsApp *</span>
              <input type="tel" id="lead-phone" name="phone" required placeholder="e.g. 07891 123456" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-xs font-medium" />
            </div>
            <div>
              <span class="block text-[11px] font-semibold text-slate-600 mb-1">Email Address (Optional)</span>
              <input type="email" id="lead-email" name="email" placeholder="e.g. david@example.co.uk" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-xs font-medium" />
            </div>
          </div>
        </div>

        <div id="error-box" class="hidden p-3 bg-rose-50 border border-rose-200 text-rose-700 text-xs rounded-lg font-medium"></div>

        <button type="submit" id="submit-btn" class="w-full bg-amber-500 hover:bg-amber-600 text-slate-950 font-extrabold text-sm py-3.5 rounded-xl shadow-lg transition flex items-center justify-center cursor-pointer">
          <span id="btn-text">Get Free Fixed Quote & Check Availability →</span>
        </button>
      </form>
    </div>
  </div>

  <script is:inline>
    // 1. Check if redirected back with success
    if (window.location.search.includes('success=true')) {
      document.getElementById('lead-form')?.classList.add('hidden');
      document.getElementById('success-message')?.classList.remove('hidden');
    }

    // 2. Auto-prefill form from URL query parameters
    try {
      const params = new URLSearchParams(window.location.search);
      const pPostcode = params.get('postcode') || params.get('city');
      const pService = params.get('service');

      if (pPostcode) {
        const pcInput = document.getElementById('lead-postcode');
        if (pcInput && !pcInput.value) pcInput.value = pPostcode;
      }

      if (pService) {
        const srvMap = {
          'bathroom': 'srv-bathroom',
          'kitchen': 'srv-kitchen',
          'floor': 'srv-floor',
          'wetroom': 'srv-wetroom'
        };
        const targetId = srvMap[pService.toLowerCase()];
        if (targetId) {
          const radio = document.getElementById(targetId);
          if (radio) radio.checked = true;
        }
      }
    } catch (e) {}

    // 3. Progressive AJAX Submission
    const form = document.getElementById('lead-form');
    form?.addEventListener('submit', async function(e) {
      // If JS is active, intercept and submit via fetch with FormData
      e.preventDefault();
      
      const btn = document.getElementById('submit-btn');
      const btnText = document.getElementById('btn-text');
      const errorBox = document.getElementById('error-box');
      const successMsg = document.getElementById('success-message');

      if (errorBox) errorBox.classList.add('hidden');
      if (btnText) btnText.innerText = 'Submitting your request...';
      if (btn) btn.disabled = true;

      try {
        const formData = new FormData(form);
        const payload = Object.fromEntries(formData.entries());
        payload.timestamp = new Date().toISOString();

        const endpoint = form.getAttribute('action');
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const result = await response.json();

        if (response.ok && result.success) {
          form.classList.add('hidden');
          if (successMsg) successMsg.classList.remove('hidden');
        } else {
          throw new Error(result.error || 'Server error (' + response.status + ')');
        }
      } catch (err) {
        console.warn('AJAX submit failed, falling back to native POST...', err);
        // Fallback: If fetch had any issue (e.g. adblocker blocking fetch), submit natively!
        form.submit();
      }
    });
  </script>
</Layout>
