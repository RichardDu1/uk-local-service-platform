---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact Us | ApprovedTilers.co.uk" description="Get in touch with our team.">
  <div class="max-w-4xl mx-auto px-4 py-16 grid grid-cols-1 md:grid-cols-2 gap-12">
    <div>
      <h1 class="text-4xl font-extrabold text-slate-900 mb-6">Contact Us</h1>
      <p class="text-slate-600 mb-8">Have a question about a project, or want to join our network of approved tilers? Send us a message.</p>
      
      <div class="space-y-6">
        <div>
          <h4 class="font-bold text-slate-800">Email</h4>
          <p class="text-slate-600">support@approvedtilers.co.uk</p>
        </div>
        <div>
          <h4 class="font-bold text-slate-800">Operating Hours</h4>
          <p class="text-slate-600">Monday - Friday: 8:00 AM - 6:00 PM</p>
          <p class="text-slate-600">Saturday: 9:00 AM - 1:00 PM</p>
        </div>
      </div>
    </div>
    
    <div class="bg-white p-8 rounded-xl shadow-lg border border-slate-100">
      <h3 class="text-xl font-bold mb-4">Need a Quote?</h3>
      <p class="text-sm text-slate-600 mb-6">If you are looking for pricing on a tiling job, please use our dedicated quote form for the fastest response.</p>
      <a href="/quote" class="block w-full text-center bg-sky-700 hover:bg-sky-800 text-white font-bold py-3 rounded-lg transition">
        Go to Quote Request Form
      </a>
    </div>
  </div>
</Layout>
